// §3.6 base resupply (M8-C) — deliver a drawn amount of a drawn
// resource into the stores of colonies on the named body. Cumulative
// deliveries count (a colony that consumed what it was given still
// earned the contract); completion rides the `TransferComplete`
// colony landing, never a poll. Unlocked at tech.rocketry.3 beside
// the part test — colony logistics is the same tier of program.
(
    schema_version: 1,
    id: "contract.colony_resupply",
    display_name: "contract.colony_resupply.name",
    description: "contract.colony_resupply.desc",
    kind: ColonyResupply,
    generate: (
        weight: 2.0,
        space: ColonyResupply(
            bodies: ["terrin", "duva", "rask"],
            resources: ["ore", "food", "oxygen"],
            amount: (50.0, 500.0),
        ),
    ),
    prerequisites: [
        TechResearched("tech.rocketry.3"),
    ],
    rewards: (
        advance_funds: 10_000.0,
        completion_funds: 45_000.0,
        failure_penalty_funds: 5_000.0,
    ),
    deadline_days: None,
)

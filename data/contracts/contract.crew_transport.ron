// §3.6 crew transport (fix-plan 7.3, C34-F5) — post the drawn
// headcount at the colony occupying the drawn site. The candidate
// set is every authored site a colony can occupy; the sim's
// generation gate filters to sites hosting a live colony that
// takes crew, so the shipped list stays completable whether the
// program posts up at rask-mines or founds a terrin depot.
// Unlocks at tech.rocketry.3 beside colony_resupply — staffing a
// base is the same logistics tier as supplying one.
//
// The predicate is a LEVEL, not a ledger: `Active` roster members
// with `CrewLocation::Colony` at the site's colony(ies). The accept
// re-bases the ask to `posted_at_accept + drawn` so crew already
// stationed never satisfy a fresh signature; both posting paths
// (AssignCrewToColony and the vessel↔colony crew transfer landing)
// count.
(
    schema_version: 1,
    id: "contract.crew_transport",
    display_name: "contract.crew_transport.name",
    description: "contract.crew_transport.desc",
    kind: CrewTransport,
    generate: (
        weight: 1.5,
        space: CrewTransport(
            sites: ["terrin-launch", "terrin-downrange", "rask-mines"],
            count: (1, 3),
        ),
    ),
    prerequisites: [
        TechResearched("tech.rocketry.3"),
    ],
    rewards: (
        advance_funds: 9_000.0,
        completion_funds: 38_000.0,
        failure_penalty_funds: 5_000.0,
    ),
    deadline_days: Some(120.0),
)

// csp.engine.ember — "Ember" 60 kN upper-stage engine (§3.1 PartDef).
// Hand-authored fiction — numbers frozen at M3.
//
// Vacuum-optimised second-stage engine for the 1.25 m stack: Isp is
// high in vacuum (350 s) and poor at sea level (140 s, overexpanded
// nozzle), which is what makes staging a real decision rather than a
// suggestion. `ullage_required: true` is what the §3.4
// UllageNegativeIgnition stress rule is *for*.
(
    schema_version: 1,
    id: "csp.engine.ember",
    family: "csp.family.engine.upper",
    display_name: "part.csp.engine.ember.name",
    category: Engine,
    mass_dry_kg: 350.0,
    cost_funds: 900.0,
    size_m: (x: 1.25, y: 1.25, z: 1.4),
    build_resources: [("metal", 30.0), ("composite", 8.0)],
    attach_nodes: [
        // KSP-style inline engine: the tank mounts `top`, and a
        // decoupler or the next stage's tank may stack *beneath* the
        // nozzle plane through `bottom` (the canister precedent —
        // both faces are 1.25-class stack interfaces).
        (id: "top",    position_m: (x: 0.0, y: 0.0, z: 0.7),  direction: (x: 0.0, y: 0.0, z: 1.0),  diameter_m: 1.25),
        (id: "bottom", position_m: (x: 0.0, y: 0.0, z: -0.7), direction: (x: 0.0, y: 0.0, z: -1.0), diameter_m: 1.25),
    ],
    scale: None,
    collider: Cylinder(radius_m: 0.625, half_height_m: 0.7),
    aero: (
        cd_curve: [(mach: 0.0, coeff: 0.5), (mach: 8.0, coeff: 0.3)],
        cl_curve: [(mach: 0.0, coeff: 0.0)],
        ref_len_m: 1.4,
    ),
    thermal: (
        heat_capacity_j_per_k: 200_000.0,
        max_temp_k: 1500.0,
        emissivity: 0.8,
        conduction_w_per_k: 40.0,
    ),
    structural: (
        max_axial_n: 300_000.0,
        max_shear_n: 100_000.0,
        max_torque_nm: 15_000.0,
    ),
    variants: [
        (id: "stock",     display_name: "part.variant.stock",     cost_multiplier: 1.0, stat_multipliers: []),
        (id: "qualified", display_name: "part.variant.qualified", cost_multiplier: 1.25,
            stat_multipliers: [(BaseMtbfS, 1.3), (IspVacS, 1.03)]),
    ],
    modules: [
        Engine(
            thrust_vac_n: 60_000.0,
            isp_vac_s: 350.0,
            isp_sl_s: 140.0,
            throttle_range: (min: 0.2, max: 1.0),
            gimbal_deg: 4.0,
            ignitions: Some(12),
            rated_burn_s: 300.0,
            propellants: [("liquid_fuel", 0.45), ("oxidizer", 0.55)],
            ullage_required: true,
        ),
    ],
    reliability: (
        base_mtbf_s: 300_000.0,
        infant_mortality: 0.25,
        qualification_curve: (knots: [
            (qualification_units: 0.0,   hazard_multiplier: 1.0),
            (qualification_units: 25.0,  hazard_multiplier: 0.7),
            (qualification_units: 100.0, hazard_multiplier: 0.45),
            (qualification_units: 400.0, hazard_multiplier: 0.3),
        ]),
        regime_stress: [
            (kind: OverThrottle,            threshold: 1.0,  multiplier: 3.0),
            (kind: BurnBeyondRated,         threshold: 0.0,  multiplier: 2.0),
            (kind: Overtemperature,         threshold: 0.9,  multiplier: 4.0),
            (kind: ExcessG,                 threshold: 12.0, multiplier: 2.0),
            (kind: ExcessRestarts,          threshold: 0.0,  multiplier: 3.0),
            (kind: UllageNegativeIgnition,  threshold: 0.0,  multiplier: 5.0),
        ],
        dormant_stress: 0.02,
        failure_modes: [
            (DegradedThrust,  0.4),
            (StuckGimbal,     0.2),
            (IgnitionFailure, 0.4),
        ],
    ),
    tech_requirement: "tech.rocketry.2",
)

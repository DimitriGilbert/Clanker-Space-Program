// csp.pod.mk1 — "Tin Can" command pod (PLAN §3.1 PartDef).
// Hand-authored fiction — numbers frozen at M3.
//
// 800 kg pod for the 1.25 m stack: CrewSeat + Control is what makes a
// craft controllable (category Control, validator-enforced). The top
// node is the 0.625 m class — nose cones and science canisters snap
// there; the bottom is the standard 1.25 m stack node.
(
    schema_version: 1,
    id: "csp.pod.mk1",
    family: "csp.family.pod",
    display_name: "part.csp.pod.mk1.name",
    category: Control,
    mass_dry_kg: 800.0,
    cost_funds: 2400.0,
    size_m: (x: 1.25, y: 1.25, z: 1.0),
    build_resources: [("metal", 60.0)],
    attach_nodes: [
        (id: "top",    position_m: (x: 0.0, y: 0.0, z: 0.5),  direction: (x: 0.0, y: 0.0, z: 1.0),  diameter_m: 0.625),
        (id: "bottom", position_m: (x: 0.0, y: 0.0, z: -0.5), direction: (x: 0.0, y: 0.0, z: -1.0), diameter_m: 1.25),
    ],
    scale: None,
    collider: Cylinder(radius_m: 0.625, half_height_m: 0.5),
    aero: (
        cd_curve: [(mach: 0.0, coeff: 0.45), (mach: 1.0, coeff: 0.55), (mach: 8.0, coeff: 0.30)],
        cl_curve: [(mach: 0.0, coeff: 0.05), (mach: 8.0, coeff: 0.05)],
        ref_len_m: 1.0,
    ),
    thermal: (
        heat_capacity_j_per_k: 400_000.0,
        max_temp_k: 1200.0,
        emissivity: 0.7,
        conduction_w_per_k: 40.0,
    ),
    structural: (
        max_axial_n: 500_000.0,
        max_shear_n: 200_000.0,
        max_torque_nm: 30_000.0,
    ),
    variants: [
        (id: "stock", display_name: "part.variant.stock", cost_multiplier: 1.0, stat_multipliers: []),
    ],
    modules: [
        CrewSeat(slots: 2),
        Control(torque_nm: 2_000.0, power_w: 50.0),
    ],
    reliability: (
        base_mtbf_s: 800_000.0,
        infant_mortality: 0.1,
        qualification_curve: (knots: [
            (qualification_units: 0.0,   hazard_multiplier: 1.0),
            (qualification_units: 50.0,  hazard_multiplier: 0.6),
            (qualification_units: 200.0, hazard_multiplier: 0.35),
        ]),
        regime_stress: [
            (kind: Overtemperature, threshold: 0.9, multiplier: 4.0),
        ],
        dormant_stress: 0.02,
        failure_modes: [
            (SensorFault, 0.7),
            (PanelJam, 0.3),
        ],
    ),
    tech_requirement: "tech.start",
)

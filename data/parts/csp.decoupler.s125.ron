// csp.decoupler.s125 — "Shear" stack decoupler (§3.1 PartDef).
// Hand-authored fiction — numbers frozen at M3.
//
// The staging part: on activation the attach node below severs —
// §2.4's graph split, no joint. Its authored failure mode is the
// §3.4-canonical "stuck decoupler". Category Utility: decouplers are
// a browser bucket, not a module-bearing structural class.
(
    schema_version: 1,
    id: "csp.decoupler.s125",
    family: "csp.family.decoupler",
    display_name: "part.csp.decoupler.s125.name",
    category: Utility,
    mass_dry_kg: 60.0,
    cost_funds: 300.0,
    size_m: (x: 1.25, y: 1.25, z: 0.25),
    build_resources: [("metal", 5.0), ("composite", 1.0)],
    attach_nodes: [
        (id: "top",    position_m: (x: 0.0, y: 0.0, z: 0.125),  direction: (x: 0.0, y: 0.0, z: 1.0),  diameter_m: 1.25),
        (id: "bottom", position_m: (x: 0.0, y: 0.0, z: -0.125), direction: (x: 0.0, y: 0.0, z: -1.0), diameter_m: 1.25),
    ],
    scale: None,
    collider: Cylinder(radius_m: 0.625, half_height_m: 0.125),
    aero: (

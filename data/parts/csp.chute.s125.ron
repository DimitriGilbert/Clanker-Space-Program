// csp.chute.s125 — "Umbrella" radial-mount parachute (§3.1 PartDef).
// Hand-authored fiction.
//
// The recovery part: a side-mount canister carrying a `Parachute`
// deployable-decelerator module. `SimCommand::DeployPart` arms the
// canopy; it stays packed until the flow can hold it — below 16 km
// AND 1200 m/s — then inflates over `deploy_time_s` from the
// gate-crossing, and its pull is reefed to the mount's authored
// rating (`structural` below) so a hard catch slides instead of
// tearing the canister off. 700 m² of Cd·A lands the dry Stock
// Hopper (2.1 t) at 7 m/s — slow enough to land intact and make
// `RecoverData` a real path.
//
// Why those numbers (M4c landing, measured): the Stock Hopper is
// slippery — free fall from a 70 km apogee still reaches ~300 m/s at
// the ground — so the earlier 6 km / 260 m/s gates only let the
// canopy catch in its last metres, and 120 m² (15.5 m/s) touched down
// harder than the stack's inline joints survive. Reefed to 54 kN the
// canopy needs ~6 km to bring a dry Hopper down from 600 m/s (1.5 km
// from 250 m/s), so the gates let it catch at 16 km: a 70 km return
// passes it at 886 m/s, the catch loads the mount to 43% of its axial
// rating, and the 7 m/s touchdown leaves every inline joint under a
// fifth of its limit (worst: the battery joint's axial at 18%).
//
// The REAL survival envelope: deploy-early is safe — the canopy
// waits out the ceilings packed — and any catch with ~6 km beneath
// it lands. The kill cases are energy and entry heat: a late deploy
// (below ~2 km at 250 m/s, ~6 km at 600 m/s) opens too late, and on
// a genuinely hot entry (km/s-class) the canister's own packed drag
// + aero load exceeds the 150 kN/60 kN mount before the speed gate
// ever passes. Note for stack design: at orbital entry speeds the
// editor-default top-mounted science.canister + battery.z1k strip
// at ~15–25 km under aero load REGARDLESS of the chute — plan
// recovery legs accordingly (accepted behavior, M4c loads). Mount
// it on the stack's TOP node to land. A radial mount holds only in
// gentle flow: on a lone pod nothing caps the canister's own packed
// drag and aero load across its 0.25 m lever — it holds to 270 m/s
// at 1.5 km and tears off at 280, and at 4 km it holds at 300 m/s
// (92.1% of the mount's rating) and tears off at 350 — past the
// mount's 8 kN·m. On a stack the pull-path reef caps the canister's
// whole drag at what the joints below take (9 kN on the Stock Hopper
// at 250 m/s, its own packed drag 12 kN) — so it holds, and reefed
// that low it cannot land the stack (149 m/s).
// Its authored dominant failure mode is §3.4's `PanelJam` —
// the deploy hardware is the part.
// Category Utility: a decelerator is a browser bucket, not a
// module-bearing structural class.
(
    schema_version: 1,
    id: "csp.chute.s125",
    family: "csp.family.recovery",
    display_name: "part.csp.chute.s125.name",
    category: Utility,
    mass_dry_kg: 55.0,
    cost_funds: 420.0,
    size_m: (x: 0.5, y: 0.25, z: 0.25),
    build_resources: [("composite", 4.0), ("metal", 2.0)],
    attach_nodes: [
        // Radial mount: the canister's −x face mates a synthesized
        // `surf:` node on the parent's hull (session convention).
        (id: "mount", position_m: (x: -0.25, y: 0.0, z: 0.0), direction: (x: -1.0, y: 0.0, z: 0.0), diameter_m: 0.625),
    ],
    scale: None,
    // A slim canister, and its lateral size is load-bearing. The
    // Stage-2 aero tables voxelise the craft on a 0.15 m grid whose
    // origin is the craft's own bounding box, and the pod's near-axial
    // lift direction is only symmetric for a centred raster. Two
    // voxels wide (half-extent 0.125) the canister keeps it centred on
    // the Stock Hopper; at 0.2 × 0.25 the voxel block sat off the pod's
    // raster centre and the lift became a constant ~1 kN·m turning
    // moment (120 m/s): the hopper has no pitch damping, so it pitched
    // over four seconds into an unguided full-throttle climb and broke
    // at the battery joint. `stock_hopper_climbs_under_full_throttle`
    // (csp-sim) holds the line.
    collider: Box(half_extents_m: (x: 0.25, y: 0.125, z: 0.125)),
    aero: (
        cd_curve: [(mach: 0.0, coeff: 0.5), (mach: 8.0, coeff: 0.35)],
        cl_curve: [(mach: 0.0, coeff: 0.0)],
        ref_len_m: 0.5,
    ),
    thermal: (
        heat_capacity_j_per_k: 40_000.0,
        max_temp_k: 900.0,
        emissivity: 0.8,
        conduction_w_per_k: 40.0,
    ),
    structural: (
        max_axial_n: 150_000.0,
        max_shear_n: 60_000.0,
        max_torque_nm: 8_000.0,
    ),
    variants: [
        (id: "stock", display_name: "part.variant.stock", cost_multiplier: 1.0, stat_multipliers: []),
    ],
    modules: [
        Parachute(
            deploy_alt_m: 16_000.0,
            deploy_speed_mps: 1_200.0,
            packed_drag_area_m2: 0.4,
            deployed_drag_area_m2: 700.0,
            deploy_time_s: 1.5,
        ),
    ],
    reliability: (
        base_mtbf_s: 2_000_000.0,
        infant_mortality: 0.08,
        qualification_curve: (knots: [
            (qualification_units: 0.0,   hazard_multiplier: 1.0),
            (qualification_units: 100.0, hazard_multiplier: 0.6),
            (qualification_units: 400.0, hazard_multiplier: 0.4),
        ]),
        regime_stress: [
            (kind: Overtemperature, threshold: 0.9,  multiplier: 4.0),
            (kind: ExcessG,         threshold: 12.0, multiplier: 2.5),
        ],
        dormant_stress: 0.01,
        failure_modes: [
            (PanelJam,    0.7),
            (SensorFault, 0.3),
        ],
    ),
    tech_requirement: "tech.start",
)

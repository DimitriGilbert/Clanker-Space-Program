// csp.structure.adapter — "Rib" interstage adapter (§3.1 PartDef).
// Hand-authored fiction — numbers frozen at M3.
//
// A hollow 1.25 m ring: high axial strength for its mass, no modules —
// Structure parts exist purely for spacing, payload cradles, and
// engine-mount geometry. Discrete scaling covers the half/h-double
// heights.
(
    schema_version: 1,
    id: "csp.structure.adapter",
    family: "csp.family.structure",
    display_name: "part.csp.structure.adapter.name",
    category: Structure,
    mass_dry_kg: 150.0,
    cost_funds: 250.0,
    size_m: (x: 1.25, y: 1.25, z: 0.5),
    build_resources: [("metal", 15.0)],
    attach_nodes: [
        (id: "top",    position_m: (x: 0.0, y: 0.0, z: 0.25),  direction: (x: 0.0, y: 0.0, z: 1.0),  diameter_m: 1.25),
        (id: "bottom", position_m: (x: 0.0, y: 0.0, z: -0.25), direction: (x: 0.0, y: 0.0, z: -1.0), diameter_m: 1.25),
    ],
    scale: Discrete([0.5, 1.0, 2.0]),
    collider: Cylinder(radius_m: 0.625, half_height_m: 0.25),
    aero: (
        cd_curve: [(mach: 0.0, coeff: 0.4), (mach: 8.0, coeff: 0.25)],
        cl_curve: [(mach: 0.0, coeff: 0.0)],
        ref_len_m: 0.5,
    ),
    thermal: (
        heat_capacity_j_per_k: 80_000.0,
        max_temp_k: 1100.0,
        emissivity: 0.7,
        conduction_w_per_k: 120.0,
    ),
    structural: (
        max_axial_n: 1_500_000.0,
        max_shear_n: 400_000.0,
        max_torque_nm: 80_000.0,
    ),
    variants: [
        (id: "stock", display_name: "part.variant.stock", cost_multiplier: 1.0, stat_multipliers: []),
    ],
    modules: [],
    reliability: (
        base_mtbf_s: 5_000_000.0,
        infant_mortality: 0.02,
        qualification_curve: (knots: [
            (qualification_units: 0.0, hazard_multiplier: 1.0),
        ]),
        regime_stress: [
            (kind: ExcessG,         threshold: 20.0, multiplier: 2.0),
            (kind: Overtemperature, threshold: 0.95, multiplier: 3.0),
        ],
        dormant_stress: 0.005,
        failure_modes: [
            (Explosion, 1.0),
        ],
    ),
    tech_requirement: "tech.start",
)

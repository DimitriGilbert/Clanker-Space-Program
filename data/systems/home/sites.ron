// The home system's surface sites (PLAN §3.5) — program geography:
// launch pads and recovery locations. `launch: true` marks the body's
// launch site (recovery_efficiency 1.0); every other site recovers at
// balance.ron's recovery_efficiency (0.9).
//
// v2 (M8-B): `resource_yields` — per-site mineable concentrations a
// colony Drill extracts against. Terrin's pads are modest; Rask's
// mining site is the rich pull into the colony game.
//
// Loop-closure decision (fix-plan 3.1): §3.5's
// "resources ◄── colonies/ISRU" edge runs over the EXISTING
// colony→vessel `TransferColonyResource` end — a surface-latched
// vessel `JoinColonyInventory`s, loads colony produce into a cargo
// tank (`csp.tank.ore.s`), and `RecoverVessel` credits the tank
// CONTENTS to the recovery site's inventory at its efficiency
// (1.0 at a launch site). The alternative — refunding the craft's
// embodied `build_resources` at recovery — was rejected: §3.5
// specifies recovery credits contents only, and `CraftDef` does not
// carry the resolved BOM.
(
    schema_version: 3,
    sites: [
        (
            id: "terrin-launch",
            display_name: "site.terrin-launch",
            body: "terrin",
            // The pad sits just south of the equator on a shoreline —
            // see the longitude note.
            latitude_rad: -0.092,
            // The sun sits at −X at t=0 (Terrin orbits at +X), so a pad
            // near lon π spawns in daylight instead of on the night
            // side. lon 2.916 (−0.226 rad from the sun meridian) is a
            // MORNING pad — ~1.7 h of daylight remain at spawn. The
            // exact site is terrain-aware: the sim's contact surface
            // AND the rendered terrain are the same baked heightfield
            // (noise_seed 601). M5 §5.2-R2 re-authored that field to
            // the steep Mountain spectrum (ridge p99 19.9°), and the
            // re-siting probe (`csp-view`'s ignored `pad_resite_scan`)
            // kept the pad at its legacy coordinates through BOTH
            // re-authorings: under the steep field the ±5° window's
            // 1681 candidates still put the legacy site at 0.159 m
            // max−min over a 30 m footprint ring (target ≤ ±0.5 m;
            // the strict minimum, 0.017 m, sits 0.35° SW — one grid
            // step west and one south — a 14 cm gain not worth moving
            // the pad off its documented morning-pad longitude) — the
            // field there rose from +14.36 m to +52.00 m over datum,
            // so `altitude_m` tracks it and the craft keeps resting
            // on the rendered ground.
            longitude_rad: 2.916,
            altitude_m: 52.0,
            launch: true,
            resource_yields: [
                ("ore", 0.35),
                ("water", 0.15),
            ],
            // W2.6 §3.5: the pad's starting stockpile — what
            // ManufactureCraft BOMs (parts' `build_resources`) and
            // RunBenchTest stands (`reliability_bench_resource` =
            // metal) spend. ~12 starter-craft equivalents of metal
            // plus composite for the electronics-heavy parts. It
            // refills by logistics, not by fiat: recovery at the pad
            // credits a recovered vessel's tank CONTENTS here at 1.0,
            // so the refill run is a cargo carrier (`csp.tank.ore.s`)
            // hauling colony metal/composite home — see the header.
            starting_stock: [
                ("metal", 2000.0),
                ("composite", 400.0),
            ],
        ),
        (
            id: "terrin-downrange",
            display_name: "site.terrin-downrange",
            body: "terrin",
            // Re-sited twice by the M5 §5.2-R2 relief re-authorings.
            // First (gentle Mountain): the (0, 3.927) datum point
            // drowned, moving the marker 6.5° SSE to a shoreline bench.
            // Then the steep Mountain spectrum (ridge p99 19.9°) pulled
            // Terrin's land fraction down further (~55% → ~32%): that
            // bench now sits −257 m under the new ocean. The ±5°
            // re-scan still found 108 dry candidates, so the marker
            // moved again — 4.3° ESE to the SECOND-flattest dry
            // candidate in the window: +17.12 m over datum, 0.172 m
            // flat over a 30 m ring (the strict 0.150 minimum sits
            // 0.8° farther ESE — the chosen site is nearer the drowned
            // bench; the nearest dry land of all, 3.0° away, is 1.05 m
            // rugged — nothing berths here, but flat is free). The
            // marker anchors at the field height and recovery is
            // commanded, not landed.
            latitude_rad: -0.12217304763960308, // −7°
            longitude_rad: 4.0448005414968586,
            altitude_m: 17.12,
            launch: false,
            resource_yields: [
                ("ore", 0.20),
            ],
        ),
        (
            id: "rask-mines",
            display_name: "site.rask-mines",
            body: "rask",
            // lon ~2.42 puts the spawn meridian ~0.72 rad into daylight
            // — |cos H0| = 0.751 of terminator margin (C09-F2/C34-F3):
            // the shipped π/2 parked the outpost ON the line, where its
            // permanent Day verdict hung on a +6.1e-17 cosine residue
            // (one longitude ulp flipped it to permanent Night). Rask's
            // day/night still cycles — it is locked to Terrin, not the
            // sun — so this margin buys a clean day-side spawn (~51.5 ks
            // to first dusk), not a permanently-lit claim; see the
            // colonies.ron header.
            //
            // Re-sited off the datum point (M5 §5.2-R2): rask's new
            // Mountain field at (0, 2.4) sits −98.7 m under datum,
            // where `altitude_m ≥ 0` is unsatisfiable (the site
            // validator's floor, which colony founding shares). The
            // re-siting probe's flattest dry candidate within ±5° —
            // 4.0° SSE at lon 2.42182/lat −0.06545 — lifts the
            // outpost onto a bench the spectrum steepening then raised
            // from +31.19 m to +95.14 m over datum: the steep-field
            // re-audit kept the COORDINATES (0.184 m flat over a 30 m
            // ring — pad-grade, 7th flattest of the window's 128 dry
            // candidates) and re-authored only the altitude. The
            // longitude is untouched, so the 0.751 |cos H0| spawn
            // margin below is exactly the number the gentle-spectrum
            // re-site documented.
            latitude_rad: -0.06544984694978735, // −3.75°
            longitude_rad: 2.421816615649929,
            altitude_m: 95.14,
            launch: false,
            resource_yields: [
                ("ore", 0.9),
                ("water", 0.3),
            ],
        ),
    ],
)

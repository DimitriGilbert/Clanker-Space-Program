            longitude_rad: 0.0,
            altitude_m: 0.0,
            launch: true,
            resource_yields: [
                ("ore", 0.35),
                ("water", 0.15),
            ],
        ),
        (
            schema_version: 2,
            id: "terrin-downrange",

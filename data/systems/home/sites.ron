// The home system's surface sites (PLAN §3.5) — program geography:
// launch pads and recovery locations. `launch: true` marks the body's
// launch site (recovery_efficiency 1.0); every other site recovers at
// balance.ron's recovery_efficiency (0.9).
//
// v2 (M8-B): `resource_yields` — per-site mineable concentrations a
// colony Drill extracts against. Terrin's pads are modest; Rask's
// mining site is the rich pull into the colony game.
(
    schema_version: 3,
    sites: [
        (
            schema_version: 3,
            id: "terrin-launch",
            display_name: "site.terrin-launch",
            body: "terrin",
            // The pad sits just south of the equator on a shoreline —
            // see the longitude note.
            latitude_rad: -0.092,
            // The sun sits at −X at t=0 (Terrin orbits at +X), so a pad
            // near lon π spawns in daylight instead of on the night
            // side. lon 2.916 (−0.226 rad from the sun meridian) is a
            // MORNING pad — ~1.7 h of daylight remain at spawn. The
            // exact site is terrain-aware: the sim's contact surface
            // AND the rendered terrain are the same baked heightfield
            // (noise_seed 601) — at lon π that surface sits ~+57 m
            // above datum, where a flat-ish pad site would have the
            // craft parked on a slope. At (−0.092, 2.916) the baked
            // field is +0.02 m against datum and flat to ±0.5 m over
            // the pad footprint, so the craft visibly rests on the
            // rendered ground AND the datum-altimetry numbers stay
            // honest.
            longitude_rad: 2.916,
            altitude_m: 0.0,
            launch: true,
            resource_yields: [
                ("ore", 0.35),
                ("water", 0.15),
            ],
            // W2.6 §3.5: the pad's starting stockpile — what
            // ManufactureCraft BOMs (parts' `build_resources`) and
            // RunBenchTest stands (`reliability_bench_resource` =
            // metal) spend. ~12 starter-craft equivalents of metal
            // plus composite for the electronics-heavy parts;
            // recovery at the pad (efficiency 1.0) refills it.
            starting_stock: [
                ("metal", 2000.0),
                ("composite", 400.0),
            ],
        ),
        (
            schema_version: 3,
            id: "terrin-downrange",
            display_name: "site.terrin-downrange",
            body: "terrin",
            latitude_rad: 0.0,
            longitude_rad: 3.9269908169872414,
            altitude_m: 0.0,
            launch: false,
            resource_yields: [
                ("ore", 0.20),
            ],
        ),
        (
            schema_version: 3,
            id: "rask-mines",
            display_name: "site.rask-mines",
            body: "rask",
            latitude_rad: 0.0,
            longitude_rad: 1.5707963267948966,
            altitude_m: 0.0,
            launch: false,
            resource_yields: [
                ("ore", 0.9),
                ("water", 0.3),
            ],
        ),
    ],
)

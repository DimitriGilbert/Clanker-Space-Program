        (index: 1, id: "terrin.grassland", name: "biome.terrin.grassland"),
        (index: 2, id: "terrin.forest", name: "biome.terrin.forest"),
        (index: 3, id: "terrin.desert", name: "biome.terrin.desert"),
        (index: 4, id: "terrin.mountains", name: "biome.terrin.mountains"),
        (index: 5, id: "terrin.tundra", name: "biome.terrin.tundra"),
        (index: 6, id: "terrin.ice_caps", name: "biome.terrin.ice_caps"),
    ],

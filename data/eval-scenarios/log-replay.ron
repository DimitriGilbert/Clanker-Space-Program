// M9d eval suite — the `Log` source: a verbatim command log re-issued
// at its recorded ticks (§7.6 dequeue-stamp semantics, scenario-declared:
// a command enqueued while the clock stands at `tick` drains at that
// boundary stamped `tick`). The agent hops the clock onto each step's
// tick with AdvanceTo, then issues the command on the boundary where
// `snap.tick == step.tick` — so `tick: 64` below lands stamped 64, not
// 63. The clock can never retreat, and a step behind it faults the
// agent.
(
    schema_version: 1,
    name: "log-replay",
    world: Empty,
    agent: Log([
        (tick: 64, command: SetWarp(4)),
        (tick: 128, command: AdvanceTo(512)),
    ]),
    goals: [
        (field: "tick", op: ge, value: 512),
        (field: "warp_level", op: eq, value: 4),
    ],
    tick_budget: 1_000_000,
    event_budget: 256,
)

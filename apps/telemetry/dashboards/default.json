{
  "schema_version": 1,
  "name": "default",
  "title": "Flight Telemetry",
  "rate_hz": 16,
  "widgets": [
    {
      "id": "altitude",
      "kind": "gauge",
      "title": "Altitude",
      "fields": ["vessels.0.altitude_m"],
      "rect": { "x": 0, "y": 0, "w": 3, "h": 2 },
      "options": { "unit": "m", "min": 0, "max": 120000 }
    },
    {
      "id": "speed",
      "kind": "gauge",
      "title": "Speed",
      "fields": ["vessels.0.speed_mps"],
      "rect": { "x": 3, "y": 0, "w": 3, "h": 2 },
      "options": { "unit": "m/s", "min": 0, "max": 3000 }
    },
    {
      "id": "throttle",
      "kind": "gauge",
      "title": "Throttle",
      "fields": ["vessels.0.throttle"],
      "rect": { "x": 6, "y": 0, "w": 3, "h": 2 },
      "options": { "min": 0, "max": 1 }
    },
    {
      "id": "apsides",
      "kind": "table",
      "title": "Orbit",
      "fields": [
        "vessels.0.apoapsis_altitude_m",
        "vessels.0.periapsis_altitude_m",
        "vessels.0.time_to_apoapsis_s",
        "vessels.0.residence"
      ],
      "rect": { "x": 9, "y": 0, "w": 3, "h": 4 },
      "options": {}
    },
    {
      "id": "alt-trace",
      "kind": "graph",
      "title": "Altitude trace",
      "fields": ["vessels.0.altitude_m"],
      "rect": { "x": 0, "y": 2, "w": 4, "h": 4 },
      "options": { "window_s": 60 }
    },
    {
      "id": "vspeed-trace",
      "kind": "graph",
      "title": "Vertical speed",
      "fields": ["vessels.0.vertical_speed_mps"],
      "rect": { "x": 4, "y": 2, "w": 5, "h": 4 },
      "options": { "window_s": 60 }
    },
    {
      "id": "orbit",
      "kind": "orbit-map",
      "title": "Orbit map",
      "fields": ["vessels.0.elements", "vessels.0.pos_m"],
      "rect": { "x": 9, "y": 4, "w": 3, "h": 4 },
      "options": {}
    },
    {
      "id": "world",
      "kind": "table",
      "title": "World",
      "fields": ["tick", "warp_level", "vessels.0.mass_kg", "vessels.0.control_lease"],
      "rect": { "x": 0, "y": 6, "w": 4, "h": 2 },
      "options": {}
    }
  ]
}

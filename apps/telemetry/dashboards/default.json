{
  "schema_version": 1,
  "name": "default",
  "title": "Flight Telemetry",
  "rate_hz": 16,
  "widgets": [
    {
      "id": "altitude",
      "kind": "gauge",
      "title": "Altitude",
      "fields": ["focus.altitude_m"],
      "rect": { "x": 0, "y": 0, "w": 3, "h": 2 },
      "options": { "unit": "m", "min": 0, "max": 120000 }
    },
    {
      "id": "speed",
      "kind": "gauge",
      "title": "Speed",
      "fields": ["focus.speed_mps"],
      "rect": { "x": 3, "y": 0, "w": 3, "h": 2 },
      "options": { "unit": "m/s", "min": 0, "max": 3000 }
    },
    {
      "id": "throttle",
      "kind": "gauge",
      "title": "Throttle",
      "fields": ["focus.throttle"],
      "rect": { "x": 6, "y": 0, "w": 3, "h": 2 },
      "options": { "min": 0, "max": 1 }
    },
    {
      "id": "apsides",
      "kind": "table",
      "title": "Orbit",
      "fields": [
        "focus.apoapsis_altitude_m",
        "focus.periapsis_altitude_m",
        "focus.time_to_apoapsis_s",
        "focus.residence"
      ],
      "rect": { "x": 9, "y": 0, "w": 3, "h": 4 },
      "options": {}
    },
    {
      "id": "alt-trace",
      "kind": "graph",
      "title": "Altitude trace",
      "fields": ["focus.altitude_m"],
      "rect": { "x": 0, "y": 2, "w": 4, "h": 4 },
      "options": { "window_s": 60 }
    },
    {
      "id": "vspeed-trace",
      "kind": "graph",
      "title": "Vertical speed",
      "fields": ["focus.vertical_speed_mps"],
      "rect": { "x": 4, "y": 2, "w": 5, "h": 4 },
      "options": { "window_s": 60 }
    },
    {
      "id": "orbit",
      "kind": "orbit-map",
      "title": "Orbit map",
      "fields": ["focus.elements", "focus.pos_m"],
      "rect": { "x": 9, "y": 4, "w": 3, "h": 4 },
      "options": {}
    },
    {
      "id": "world",
      "kind": "table",
      "title": "World",
      "fields": ["tick", "warp_level", "focus_vessel_id", "focus.mass_kg", "focus.control_lease"],
      "rect": { "x": 0, "y": 6, "w": 4, "h": 2 },
      "options": {}
    },
    {
      "id": "program",
      "kind": "table",
      "title": "Program",
      "fields": [
        "program.funds_micros",
        "program.science_banked",
        "program.contract_offers",
        "program.contracts_active",
        "program.tech_researched",
        "program.crew_roster",
        "program.sites"
      ],
      "rect": { "x": 4, "y": 6, "w": 5, "h": 3 },
      "options": {}
    },
    {
      "id": "holdings",
      "kind": "table",
      "title": "Colonies & Scripts",
      "fields": ["program.colonies", "program.scripts", "program.autopilots"],
      "rect": { "x": 9, "y": 8, "w": 3, "h": 3 },
      "options": {}
    }
  ]
}

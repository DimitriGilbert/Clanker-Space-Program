// The §6.3 demo's surface sites — the home system's Terrin sites only
// (Rask's mining site does not exist in the demo data set). `launch:
// true` marks the body's launch site (recovery_efficiency 1.0); every
// other site recovers at balance.ron's recovery_efficiency (0.9).
(
    schema_version: 3,
    sites: [
        (
            schema_version: 3,
            id: "terrin-launch",
            display_name: "site.terrin-launch",
            body: "terrin",
            // Mirror of data/systems/home/sites.ron: just south of the
            // equator on a shoreline where the baked heightfield
            // (noise_seed 601) — which is BOTH the sim's contact
            // surface and the rendered ground — is ~0 m against datum:
            // a flat pad, and altimetry that stays honest. The old
            // lon-π site sits atop a +57 m hill — a pad there would
            // be parked on a slope. lon 2.916 is ~0.23 rad west of the
            // t=0 sun meridian: a morning pad, ~1.7 h of daylight at
            // spawn.
            latitude_rad: -0.092,
            longitude_rad: 2.916,
            altitude_m: 0.0,
            launch: true,
            resource_yields: [
                ("ore", 0.35),
                ("water", 0.15),
            ],
            // Mirror of data/systems/home/sites.ron — the pad's
            // starting stockpile ManufactureCraft BOMs and
            // RunBenchTest stands spend.
            starting_stock: [
                ("metal", 2000.0),
                ("composite", 400.0),
            ],
        ),
        (
            schema_version: 3,
            id: "terrin-downrange",
            display_name: "site.terrin-downrange",
            body: "terrin",
            latitude_rad: 0.0,
            longitude_rad: 3.9269908169872414,
            altitude_m: 0.0,
            launch: false,
            resource_yields: [
                ("ore", 0.20),
            ],
        ),
    ],
)

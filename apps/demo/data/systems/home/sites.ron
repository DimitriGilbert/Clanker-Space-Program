// The §6.3 demo's surface sites — the home system's Terrin sites only
// (Rask's mining site does not exist in the demo data set). `launch:
// true` marks the body's launch site (recovery_efficiency 1.0); every
// other site recovers at balance.ron's recovery_efficiency (0.9).
(
    schema_version: 2,
    sites: [
        (
            schema_version: 2,
            id: "terrin-launch",
            display_name: "site.terrin-launch",
            body: "terrin",
            latitude_rad: 0.0,
            longitude_rad: 0.0,
            altitude_m: 0.0,
            launch: true,
            resource_yields: [
                ("ore", 0.35),
                ("water", 0.15),
            ],
        ),
        (
            schema_version: 2,
            id: "terrin-downrange",
            display_name: "site.terrin-downrange",
            body: "terrin",
            latitude_rad: 0.0,
            longitude_rad: 0.7853981633974483,
            altitude_m: 0.0,
            launch: false,
            resource_yields: [
                ("ore", 0.20),
            ],
        ),
    ],
)

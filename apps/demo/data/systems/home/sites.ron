// The §6.3 demo's surface sites — the home system's Terrin sites only
// (Rask's mining site does not exist in the demo data set). `launch:
// true` marks the body's launch site (recovery_efficiency 1.0); every
// other site recovers at balance.ron's recovery_efficiency (0.9).
(
    schema_version: 3,
    sites: [
        (
            id: "terrin-launch",
            display_name: "site.terrin-launch",
            body: "terrin",
            // Mirror of data/systems/home/sites.ron: just south of the
            // equator at the legacy coordinates (a MORNING pad, ~1.7 h
            // of daylight at spawn — see the shipped file's longitude
            // note). Under the mirrored M5 §5.2-R2 Mountain field the
            // heightfield there is +52.00 m over datum, so
            // `altitude_m` tracks it and a spawned craft rests on the
            // rendered ground instead of buried inside it.
            latitude_rad: -0.092,
            longitude_rad: 2.916,
            altitude_m: 52.0,
            launch: true,
            resource_yields: [
                ("ore", 0.35),
                ("water", 0.15),
            ],
            // Mirror of data/systems/home/sites.ron — the pad's
            // starting stockpile ManufactureCraft BOMs and
            // RunBenchTest stands spend.
            starting_stock: [
                ("metal", 2000.0),
                ("composite", 400.0),
            ],
        ),
        (
            id: "terrin-downrange",
            display_name: "site.terrin-downrange",
            body: "terrin",
            // Mirror of data/systems/home/sites.ron — re-sited twice by
            // the M5 §5.2-R2 relief re-authorings: the original (0,
            // 3.927) datum point drowned under the Mountain field's
            // ocean, so the marker moved to the flattest dry candidate
            // in the ±5° re-scan window, anchored at its field height.
            // Nothing berths here — recovery is commanded, not landed.
            latitude_rad: -0.12217304763960308, // −7°
            longitude_rad: 4.0448005414968586,
            altitude_m: 17.12,
            launch: false,
            resource_yields: [
                ("ore", 0.20),
            ],
        ),
    ],
)

// csp.battery.z1k — "Cellblock" 1 kU battery (§3.1 PartDef).
// Hand-authored fiction — numbers frozen at M3.
//
// A battery is a Tank of electric_charge (§3.5: "a Cargo bay is just a
// Tank" — the same trick, applied to charge). 1 000 units of a
// massless resource: capacity is real, wet-mass delta is zero.
// 0.625 m node class — mounts under pods and small structures.
(
    schema_version: 1,
    id: "csp.battery.z1k",
    family: "csp.family.battery",
    display_name: "part.csp.battery.z1k.name",
    category: Utility,
    mass_dry_kg: 40.0,
    cost_funds: 200.0,
    size_m: (x: 0.625, y: 0.625, z: 0.4),
    build_resources: [("metal", 3.0), ("composite", 2.0)],
    attach_nodes: [
        // 1.25-class stack interfaces — the canister precedent: the
        // starter battery flies inline, mid-stack.
        (id: "top",    position_m: (x: 0.0, y: 0.0, z: 0.2),  direction: (x: 0.0, y: 0.0, z: 1.0),  diameter_m: 1.25),
        (id: "bottom", position_m: (x: 0.0, y: 0.0, z: -0.2), direction: (x: 0.0, y: 0.0, z: -1.0), diameter_m: 1.25),
    ],
    scale: None,
    collider: Box(half_extents_m: (x: 0.3125, y: 0.3125, z: 0.2)),
    aero: (
        cd_curve: [(mach: 0.0, coeff: 0.5), (mach: 8.0, coeff: 0.3)],
        cl_curve: [(mach: 0.0, coeff: 0.0)],
        ref_len_m: 0.4,
    ),
    thermal: (
        heat_capacity_j_per_k: 20_000.0,
        max_temp_k: 800.0,
        emissivity: 0.6,
        conduction_w_per_k: 30.0,
    ),
    structural: (
        max_axial_n: 150_000.0,
        max_shear_n: 60_000.0,
        max_torque_nm: 8_000.0,
    ),
    variants: [
        (id: "stock", display_name: "part.variant.stock", cost_multiplier: 1.0, stat_multipliers: []),
    ],
    modules: [
        Tank(capacity: [("electric_charge", 1000.0)]),
    ],
    reliability: (
        base_mtbf_s: 3_000_000.0,
        infant_mortality: 0.05,
        qualification_curve: (knots: [
            (qualification_units: 0.0,   hazard_multiplier: 1.0),
            (qualification_units: 100.0, hazard_multiplier: 0.5),
        ]),
        regime_stress: [
            (kind: Overtemperature, threshold: 0.9, multiplier: 5.0),
        ],
        dormant_stress: 0.01,
        failure_modes: [
            (SensorFault, 0.6),
            (Leak,        0.4),
        ],
    ),
    tech_requirement: "tech.start",
)
